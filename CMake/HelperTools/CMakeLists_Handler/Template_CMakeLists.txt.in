# Template version: @TEMPLATE_FILE_MODULE_VERSION@
# Sets the version of CMakeLists.txt file.
# Never, under any circumstances, change this line. It is used by
# the module generation script to identify the template version.

#======================== Library configuration ===============================#
# Publicly included directories to provide headers include
set( @TEMPLATE_FILE_MODULE_NAME@_PublicIncludeDirs
    @TEMPLATE_FILE_PUBLIC_INCLUDE_DIRS_LIST@
)


# Privately included directories to provide headers include
set( @TEMPLATE_FILE_MODULE_NAME@_PrivateIncludeDirs
    @TEMPLATE_FILE_PRIVATE_INCLUDE_DIRS_LIST@
)


# Source files list for current library generation
set( @TEMPLATE_FILE_MODULE_NAME@_SourceFiles
    @TEMPLATE_FILE_SOURCE_FILE_LIST@ 
)


# List of public header files provided by the current library
set( @TEMPLATE_FILE_MODULE_NAME@_PublicHeaders 
    @TEMPLATE_FILE_PUBLIC_HEADER_LIST@ 
)


# List of dependent libraries that are publicly used by the current library
set( @TEMPLATE_FILE_MODULE_NAME@_PublicDependentLibs
    @TEMPLATE_FILE_PUBLIC_DEPENDENT_LIBS_LIST@ 
)


# List of dependent libraries that are privately used by the current library
set( @TEMPLATE_FILE_MODULE_NAME@_PrivateDependentLibs
    @TEMPLATE_FILE_PRIVATE_DEPENDENT_LIBS_LIST@ 
)


#========================== Library generation ================================#
# Create library
add_library(@TEMPLATE_FILE_MODULE_NAME@_Lib STATIC ${@TEMPLATE_FILE_MODULE_NAME@_SourceFiles})


# Include necessary libraries to the target
target_link_libraries( @TEMPLATE_FILE_MODULE_NAME@_Lib
    PUBLIC 
        ${@TEMPLATE_FILE_MODULE_NAME@_PublicDependentLibs} 
    PRIVATE 
        ${@TEMPLATE_FILE_MODULE_NAME@_PrivateDependentLibs}
)


# Set public headers directory path in build folder
set(PUBLIC_HEADERS_DIR ${CMAKE_CURRENT_BINARY_DIR}/PublicHeaders)

# Generates the public headers directory in build folder
file(MAKE_DIRECTORY ${PUBLIC_HEADERS_DIR})

# Process all public headers
foreach(PublicHeader IN LISTS @TEMPLATE_FILE_MODULE_NAME@_PublicHeaders)
    
    # Copy (or configure) only the public header there
    configure_file(
        ${CMAKE_CURRENT_SOURCE_DIR}/${PublicHeader} 
        ${PUBLIC_HEADERS_DIR}/${PublicHeader}
        COPYONLY
    )
    
endforeach()


# Set include directories for the created target
target_include_directories( @TEMPLATE_FILE_MODULE_NAME@_Lib
    PUBLIC
        $<BUILD_INTERFACE:${PUBLIC_HEADERS_DIR}>
        $<INSTALL_INTERFACE:include>
        @TEMPLATE_FILE_MODULE_NAME@_PublicIncludeDirs
    PRIVATE
        ${@TEMPLATE_FILE_MODULE_NAME@_IncludeDirs}
        @TEMPLATE_FILE_MODULE_NAME@_PrivateIncludeDirs
)


# Print status message
message(STATUS "@TEMPLATE_FILE_MODULE_NAME@_Lib library created")

#========================= Documentation configuration ========================#
if(DOXYGEN_AVAILABLE STREQUAL "ON")
    Doxygen_AddPath("${CMAKE_CURRENT_SOURCE_DIR}/")
endif()