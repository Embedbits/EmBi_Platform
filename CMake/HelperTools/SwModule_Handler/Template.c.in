/**
 * \brief Returns module SW version
 *
 * \return Module SW version
 */
@TYPE_NAME@_ModuleVersion_t @FUNCTION_PREFIX@_Get_ModuleVersion( void )
{
    @TYPE_NAME@_ModuleVersion_t retVersion;

    retVersion.Major = @MACRO_NAME@_MAJOR_VERSION;
    retVersion.Minor = @MACRO_NAME@_MINOR_VERSION;
    retVersion.Patch = @MACRO_NAME@_PATCH_VERSION;

    return (retVersion);
}


