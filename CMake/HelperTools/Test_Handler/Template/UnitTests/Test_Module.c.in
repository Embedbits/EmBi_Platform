/* =============================== TESTS ==================================== */

/**
 * \brief   @MODULE_NAME@_Get_ModuleVersion() returns version of the module.
 *
 * \details Reads the module version structure.
 *
 * \par Expected results
 * - Version is 1.0.0 (Major 1, Minor 0, Patch 0).
 */
void Ut_@MODULE_NAME@_Get_ModuleVersion_ReturnsVersion( void )
{
    @TYPE_NAME@_ModuleVersion_t version = @MODULE_NAME@_Get_ModuleVersion();

    TEST_ASSERT_EQUAL_UINT8( 1u, version.Major );
    TEST_ASSERT_EQUAL_UINT8( 0u, version.Minor );
    TEST_ASSERT_EQUAL_UINT8( 0u, version.Patch );
}

