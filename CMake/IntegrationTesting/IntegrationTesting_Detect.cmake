################################################################################
# Author: Mr.Nobody
# file:  IntegrationTesting_Detect.cmake
# brief: Detection of boards connected to debug probes - writes the boards file
#        of the connected boards (Build/IntegrationTestBoards.json).
#
# Usage (from the project root folder with CMakePresets.json):
#   cmake -P EmBi_Platform/CMake/IntegrationTesting/IntegrationTesting_Detect.cmake
# or included by host scripts (IntegrationTesting_DetectBoards).
#
# Every connected probe (probe-rs list) is identified by the MCU identification
# of the Ral presets (Bsp/Ral/RalPresets.json, IntegrationTesting_Probe.cmake) -
# ID register and flash size register are read with a generic core, matching
# MCUs with integration test preset <MCU>_IntegrationTest in the project
# CMakePresets.json are the candidates of the probe.
#
# Board configuration of the project (ItBoards.json in the project root) is
# optional - an override of the detected boards:
#   { "boards": { "<board>": { "preset": "<MCU>_IntegrationTest",
#                              "probes": [ "<VID:PID:SN or SN>", ... ],
#                              "cacheVariables": { "INTEGRATION_TEST_...": "<value>" } } } }
#   - board with "probes" gets these probes (if connected), MCU of the probe is
#     not checked here (the run script checks it before download)
#   - board without "probes" gets all connected probes whose MCU matches its
#     preset (eg. name of the board, ambiguous ID - STM32F405/F407 share DEV_ID)
#   - cacheVariables are passed to the configuration of the board
# Other identified probes create boards named by the MCU - of more candidates
# (same ID and flash size, eg. STM32G411xB / G431xB / G441xB) the first one
# whose device probe-rs knows (the firmware can be executed), otherwise the
# first one; the other candidates are reported. Probes without identified MCU
# are reported. A probe is locked while its registers are read
# (IntegrationTesting_Lock.cmake); a probe used by another client (debugging,
# tests, pipeline job) is not read, it is reported with its holder.
#
# Names of the boards behind the probes (labels of the targets): the fixtures
# of the probes ("probes" of the boards file of the project or of the board
# configuration of an IT agent, itDetect_ReadFixtures, which also give the board
# and the features of a probe - README, Board fixtures) and, on an IT agent, its
# names of the boards (/opt/hwgui/boards.conf), otherwise the end of the serial
# number.
#
# The boards of every IT agent of ItHosts.json (IntegrationTesting_Remote.cmake)
# are detected by the agent itself (IT agent interface, embi-agent detect: its
# probes identified by the MCUs of all families, its board configuration) and
# formed here with the presets of this project; a probe of an MCU of another
# family is reported as not usable (also when its fixture gives a board - no
# warning, the boards of an agent are of all families).
#
# Output (not versioned, regenerated by every detection):
#   { "boards":  { "<board>": { "preset": "...", "probes": [ <probes of this machine> ],
#                               "cacheVariables": { ... }, "ambiguous": true } },
#     "targets": [ { "board": "...", "probe": "<VID:PID:SN>", "host": "local" | "<IT host>",
#                    "target": "<user>@<host>", "label": "<name of the board>",
#                    "usedBy": "<holder>" } ],
#     "used":    [ { "probe": "...", "host": "...", "target": "...", "usedBy": "<holder>" } ],
#     "failed":  [ { "host": "<IT host>", "target": "<user>@<host>", "error": "<why>" } ] }
#   - a target is one physical board (one probe): ID <board>@<host>:<probe> selects it
#     (IntegrationTesting_ReadTargets, IntegrationTesting_FindTarget)
#   - "ambiguous": more probes of one MCU without the probes of the board in the
#     boards file of the project - the boards may have a different wiring, a run
#     selects one probe (two wirings = two board names in ItBoards.json)
#   - a probe used by another client keeps its target of the previous detection
#     with "usedBy"
#   - "failed": the IT agents whose boards are not listed (agent not reachable,
#     agent tools not installed) - only when there is one
#
# Optional parameters:
#   IT_MCU_PRESETS_FILE  - MCU identification (default Bsp/Ral/RalPresets.json)
#   IT_BOARDS_OVERRIDE   - Board configuration of the project (default ItBoards.json)
#   IT_BOARDS_FILE       - Output (default Build/IntegrationTestBoards.json)
#   IT_PROBE_RS          - probe-rs executable (default: IntegrationTesting_FindProbeRs)
################################################################################

cmake_minimum_required(VERSION 3.25)

include("${CMAKE_CURRENT_LIST_DIR}/IntegrationTesting_Probe.cmake")

# IT agents of ItHosts.json - their boards are detected over SSH
include("${CMAKE_CURRENT_LIST_DIR}/IntegrationTesting_Remote.cmake")

# Values of a target of IntegrationTesting_ReadTargets (IT_TARGET_<idx>_<suffix>)
set(IT_TARGET_SUFFIXES                  ID BOARD PRESET HOST TARGET PROBE LABEL USED_BY FEATURES TEXT)

#------------------------------------------------------------------------------#
# Selects the MCU of a probe from its candidates (MCUs with the same ID and
# flash size): the first candidate whose identification device probe-rs knows
# ("probe-rs chip info") - the integration test firmware of the board can be
# executed - or the first candidate when probe-rs knows none of them.
#
# MCU_VAR    [out]: Selected MCU
# PROBE_RS   [in]:  probe-rs executable
# CANDIDATES [in]:  Candidate MCUs (IT_MCU_<mcu>_DEVICE of
#                   IntegrationTesting_ReadMcuIdentification)
#------------------------------------------------------------------------------#
function(IntegrationTesting_SelectCandidate MCU_VAR PROBE_RS CANDIDATES)

    list(GET CANDIDATES 0 SELECTED)
    list(LENGTH CANDIDATES CANDIDATES_CNT)

    if(CANDIDATES_CNT GREATER 1)
        foreach(CANDIDATE IN LISTS CANDIDATES)

            if(NOT IT_MCU_${CANDIDATE}_DEVICE)
                continue()
            endif()

            execute_process(COMMAND "${PROBE_RS}" chip info "${IT_MCU_${CANDIDATE}_DEVICE}"
                            RESULT_VARIABLE CHIP_RESULT
                            OUTPUT_QUIET
                            ERROR_QUIET)

            if(CHIP_RESULT EQUAL 0)
                set(SELECTED "${CANDIDATE}")
                break()
            endif()

        endforeach()
    endif()

    set(${MCU_VAR} "${SELECTED}" PARENT_SCOPE)

endfunction(IntegrationTesting_SelectCandidate)

#------------------------------------------------------------------------------#
# JSON string of a text.
#
# JSON_VAR [out]: JSON string (with the quotes)
# TEXT     [in]:  Text
#------------------------------------------------------------------------------#
function(IntegrationTesting_JsonString JSON_VAR TEXT)

    string(REPLACE "\\" "\\\\" TEXT "${TEXT}")
    string(REPLACE "\"" "\\\"" TEXT "${TEXT}")

    set(${JSON_VAR} "\"${TEXT}\"" PARENT_SCOPE)

endfunction(IntegrationTesting_JsonString)

#------------------------------------------------------------------------------#
# Reads the fixtures of the physical boards - the manual configuration of the
# wiring and of the attached ICs (boards file of the project, the board
# configuration of an IT agent - the inventory of the pipeline, result of
# embi-agent detect):
#   { "probes": { "<serial number or selector>": { "host": "local" | "<IT agent>", "name": "<name of the board>",
#                   "board": "<board name of the firmware>", "features": { "<X>": { "<KEY>": "<value>" } },
#                   "defines": { "<NAME>": "<value>" }, "stale": true } },
#     "boards": { "<board name>": { "name": "<name>", "features": { ... }, "defines": { ... } } } }
# "boards" configures also a probe without a serial number (by the board name
# of the detection); a stale entry is not used. Sets in the parent scope (only
# the members the content has):
#   IT_FIX_PROBE_<key>_NAME, _BOARD, _FEATURES, _DEFINES (JSON objects), key of
#   IntegrationTesting_Get_LockKey; IT_FIX_BOARD_<board>_NAME, _FEATURES, _DEFINES;
#   IT_FIX_PROBE_KEYS - the keys of the configured probes
#
# FIXTURES_CONTENT [in]: JSON object ("" = none)
#------------------------------------------------------------------------------#
function(itDetect_ReadFixtures FIXTURES_CONTENT)

    if("${FIXTURES_CONTENT}" STREQUAL "")
        return()
    endif()

    foreach(SECTION IN ITEMS probes boards)

        string(JSON ITEMS_CNT ERROR_VARIABLE ITEMS_ERROR LENGTH "${FIXTURES_CONTENT}" ${SECTION})

        if(ITEMS_ERROR OR
           ITEMS_CNT EQUAL 0)
            continue()
        endif()

        math(EXPR ITEMS_LAST "${ITEMS_CNT} - 1")

        foreach(ITEM_IDX RANGE ${ITEMS_LAST})

            string(JSON ITEM MEMBER "${FIXTURES_CONTENT}" ${SECTION} ${ITEM_IDX})

            # A board no longer in the configuration of its IT agent (ItBoards.json) is not used
            string(JSON STALE ERROR_VARIABLE STALE_ERROR GET "${FIXTURES_CONTENT}" ${SECTION} "${ITEM}" stale)
            if(NOT STALE_ERROR AND
               STALE)
                continue()
            endif()

            if("${SECTION}" STREQUAL "probes")
                IntegrationTesting_Get_LockKey(ITEM_KEY "${ITEM}")
                set(PREFIX "IT_FIX_PROBE_${ITEM_KEY}")
                list(APPEND IT_FIX_PROBE_KEYS "${ITEM_KEY}")
                set(IT_FIX_PROBE_KEYS "${IT_FIX_PROBE_KEYS}" PARENT_SCOPE)
            else()
                set(PREFIX "IT_FIX_BOARD_${ITEM}")
            endif()

            foreach(MEMBER IN ITEMS name:NAME board:BOARD features:FEATURES defines:DEFINES)
                string(REPLACE ":" ";" MEMBER "${MEMBER}")
                list(GET MEMBER 0 MEMBER_NAME)
                list(GET MEMBER 1 MEMBER_SUFFIX)
                set(MEMBER_PATH ${SECTION} "${ITEM}" ${MEMBER_NAME})
                string(JSON VALUE ERROR_VARIABLE VALUE_ERROR GET "${FIXTURES_CONTENT}" ${MEMBER_PATH})
                if(NOT VALUE_ERROR)
                    set(${PREFIX}_${MEMBER_SUFFIX} "${VALUE}" PARENT_SCOPE)
                endif()
            endforeach()

        endforeach()

    endforeach()

endfunction(itDetect_ReadFixtures)

#------------------------------------------------------------------------------#
# Names of the features of a fixture, for messages and board lists.
#
# NAMES_VAR     [out]: Names separated by ", " ("none" for an empty fixture)
# FEATURES_JSON [in]:  Features (JSON object)
#------------------------------------------------------------------------------#
function(itDetect_Get_FeatureNames NAMES_VAR FEATURES_JSON)

    set(NAMES "")

    string(JSON FEATURES_CNT ERROR_VARIABLE FEATURES_ERROR LENGTH "${FEATURES_JSON}")

    if(NOT FEATURES_ERROR AND
       FEATURES_CNT GREATER 0)
        math(EXPR FEATURES_LAST "${FEATURES_CNT} - 1")
        foreach(FEATURE_IDX RANGE ${FEATURES_LAST})
            string(JSON FEATURE MEMBER "${FEATURES_JSON}" ${FEATURE_IDX})
            list(APPEND NAMES "${FEATURE}")
        endforeach()
    endif()

    if(NAMES)
        list(JOIN NAMES ", " NAMES)
    else()
        set(NAMES "none")
    endif()

    set(${NAMES_VAR} "${NAMES}" PARENT_SCOPE)

endfunction(itDetect_Get_FeatureNames)

#------------------------------------------------------------------------------#
# Name of the board behind a probe (fixture of the probe, fixture of its board),
# otherwise the end of the serial number of the probe.
#
# NAME_VAR [out]: Name
# PROBE    [in]:  probe-rs selector
# BOARD    [in]:  Board of the probe
#------------------------------------------------------------------------------#
function(itDetect_Get_ProbeName NAME_VAR PROBE BOARD)

    IntegrationTesting_Get_LockKey(KEY "${PROBE}")

    if(NOT "${IT_FIX_PROBE_${KEY}_NAME}" STREQUAL "")
        set(NAME "${IT_FIX_PROBE_${KEY}_NAME}")
    elseif(NOT "${IT_FIX_BOARD_${BOARD}_NAME}" STREQUAL "")
        set(NAME "${IT_FIX_BOARD_${BOARD}_NAME}")
    else()
        string(LENGTH "${KEY}" KEY_LENGTH)
        if(KEY_LENGTH GREATER 8)
            math(EXPR KEY_START "${KEY_LENGTH} - 8")
            string(SUBSTRING "${KEY}" ${KEY_START} 8 KEY_END)
            set(NAME "probe ...${KEY_END}")
        else()
            set(NAME "probe ${KEY}")
        endif()
    endif()

    set(${NAME_VAR} "${NAME}" PARENT_SCOPE)

endfunction(itDetect_Get_ProbeName)

#------------------------------------------------------------------------------#
# Detects connected boards and writes the boards file of connected boards.
#
# PROJECT_DIR       [in]: Project root folder (CMakePresets.json)
# MCU_PRESETS_FILE  [in]: Ral presets with MCU identification
# OVERRIDE_FILE     [in]: Boards file of the project (may not exist)
# OUT_FILE          [in]: Boards file of connected boards
# ARGV4             [in]: Optional result of embi-agent detect of an IT agent (IT agent
#                         interface): the probes of the agent, their MCUs (identification
#                         of all families), names and the board configuration of the agent
#                         are taken from it instead of the probes of this machine
#------------------------------------------------------------------------------#
function(IntegrationTesting_DetectBoards PROJECT_DIR MCU_PRESETS_FILE OVERRIDE_FILE OUT_FILE)

    set(AGENT_JSON "")
    if(ARGC GREATER 4)
        set(AGENT_JSON "${ARGV4}")
    endif()

    # Keys of the probes of a board configuration (itDetect_ReadFixtures) - the other probes are new boards
    set(IT_FIX_PROBE_KEYS "")

    set(OVERRIDE_CONTENT "{}")
    if(EXISTS "${OVERRIDE_FILE}")
        file(READ "${OVERRIDE_FILE}" OVERRIDE_CONTENT)
    endif()

    # Names and fixtures of the physical boards: the names of the agent, its board configuration, the boards
    # file of the project - the last one wins
    set(AGENT_PROBES_CNT 0)
    if(NOT "${AGENT_JSON}" STREQUAL "")
        string(JSON AGENT_PROBES_CNT LENGTH "${AGENT_JSON}" probes)
        if(AGENT_PROBES_CNT GREATER 0)
            math(EXPR AGENT_PROBES_LAST "${AGENT_PROBES_CNT} - 1")
            foreach(AGENT_IDX RANGE ${AGENT_PROBES_LAST})
                string(JSON AGENT_PROBE GET "${AGENT_JSON}" probes ${AGENT_IDX} probe)
                string(JSON AGENT_LABEL GET "${AGENT_JSON}" probes ${AGENT_IDX} label)
                if(NOT "${AGENT_LABEL}" STREQUAL "")
                    IntegrationTesting_Get_LockKey(AGENT_KEY "${AGENT_PROBE}")
                    set(IT_FIX_PROBE_${AGENT_KEY}_NAME "${AGENT_LABEL}")
                endif()
            endforeach()
        endif()
        string(JSON AGENT_CONFIG GET "${AGENT_JSON}" config)
        itDetect_ReadFixtures("${AGENT_CONFIG}")
    endif()

    itDetect_ReadFixtures("${OVERRIDE_CONTENT}")

    IntegrationTesting_ProvideProbeRs(IT_PROBE_RS "${PROJECT_DIR}")

    # Integration test presets of the project
    set(PROJECT_PRESETS_FILE "${PROJECT_DIR}/CMakePresets.json")

    if(NOT EXISTS "${PROJECT_PRESETS_FILE}")
        message(FATAL_ERROR "${PROJECT_PRESETS_FILE} not found - execute the script from the project root folder.")
    endif()

    file(READ "${PROJECT_PRESETS_FILE}" PROJECT_PRESETS)
    string(JSON PRESETS_CNT ERROR_VARIABLE PRESETS_ERROR LENGTH "${PROJECT_PRESETS}" configurePresets)

    set(IT_PRESETS "")
    if(NOT PRESETS_ERROR AND PRESETS_CNT GREATER 0)
        math(EXPR PRESETS_LAST "${PRESETS_CNT} - 1")
        foreach(PRESET_IDX RANGE ${PRESETS_LAST})
            string(JSON PRESET_NAME GET "${PROJECT_PRESETS}" configurePresets ${PRESET_IDX} name)
            if(PRESET_NAME MATCHES "_IntegrationTest$")
                list(APPEND IT_PRESETS "${PRESET_NAME}")
            endif()
        endforeach()
    endif()

    # MCUs with identification and integration test preset
    IntegrationTesting_ReadMcuIdentification(ALL_MCUS "${MCU_PRESETS_FILE}")

    set(MCUS "")
    foreach(MCU IN LISTS ALL_MCUS)
        if("${MCU}_IntegrationTest" IN_LIST IT_PRESETS)
            list(APPEND MCUS "${MCU}")
        endif()
    endforeach()

    if(NOT MCUS)
        message(WARNING "No MCU identification for integration test presets of the project in ${MCU_PRESETS_FILE} - "
                        "boards are detected only by probes of ${OVERRIDE_FILE}.")
    endif()

    set(USED_PROBES "")
    set(PROBES "")

    if(NOT "${AGENT_JSON}" STREQUAL "")

        # Probes of the IT agent (embi-agent detect): the MCUs of the identification of all families that have
        # an integration test preset in this project; a probe of an MCU of another family is not usable here
        set(PROBE_IDX 0)
        while(PROBE_IDX LESS AGENT_PROBES_CNT)

            string(JSON PROBE   GET "${AGENT_JSON}" probes ${PROBE_IDX} probe)
            string(JSON USED_BY GET "${AGENT_JSON}" probes ${PROBE_IDX} usedBy)
            string(JSON TEXT    GET "${AGENT_JSON}" probes ${PROBE_IDX} text)
            string(JSON FAMILY  GET "${AGENT_JSON}" probes ${PROBE_IDX} family)
            string(JSON AGENT_MCUS_CNT LENGTH "${AGENT_JSON}" probes ${PROBE_IDX} mcus)

            set(AGENT_MCUS "")
            set(PROJECT_MCUS "")
            set(MCU_IDX 0)
            while(MCU_IDX LESS AGENT_MCUS_CNT)
                string(JSON AGENT_MCU GET "${AGENT_JSON}" probes ${PROBE_IDX} mcus ${MCU_IDX})
                list(APPEND AGENT_MCUS "${AGENT_MCU}")
                if("${AGENT_MCU}" IN_LIST MCUS)
                    list(APPEND PROJECT_MCUS "${AGENT_MCU}")
                endif()
                math(EXPR MCU_IDX "${MCU_IDX} + 1")
            endwhile()

            if(NOT "${AGENT_MCUS}" STREQUAL "" AND
               "${PROJECT_MCUS}" STREQUAL "")
                list(JOIN AGENT_MCUS ", " AGENT_MCUS_TEXT)
                set(TEXT "${TEXT}: ${AGENT_MCUS_TEXT} - family ${FAMILY} is not in this project")
                set(OTHER_FAMILY TRUE)
            else()
                set(OTHER_FAMILY FALSE)
            endif()

            list(APPEND PROBES "${PROBE}")
            set(PROBE_${PROBE_IDX}_MCUS         "${PROJECT_MCUS}")
            set(PROBE_${PROBE_IDX}_TEXT         "${TEXT}")
            set(PROBE_${PROBE_IDX}_USED_BY      "${USED_BY}")
            set(PROBE_${PROBE_IDX}_BOARD        "")
            set(PROBE_${PROBE_IDX}_OTHER_FAMILY ${OTHER_FAMILY})

            if(NOT "${USED_BY}" STREQUAL "")
                list(APPEND USED_PROBES "${PROBE} (${USED_BY})")
            endif()

            math(EXPR PROBE_IDX "${PROBE_IDX} + 1")

        endwhile()

    else()

        # Connected probes and their MCUs - a probe is locked while its registers are read
        # (IntegrationTesting_Lock.cmake), a probe used by another client (debugging, tests,
        # pipeline job) is not read
        IntegrationTesting_ListProbes(PROBES)
        IntegrationTesting_Get_LockHolder(DETECT_HOLDER "detection of connected boards")

        set(PROBE_IDX 0)
        foreach(PROBE IN LISTS PROBES)

            IntegrationTesting_LockProbe(LOCK_RESULT "${PROBE}" 0 "${DETECT_HOLDER}")

            if("${LOCK_RESULT}" STREQUAL "")
                IntegrationTesting_IdentifyProbe(PROBE_${PROBE_IDX}_MCUS PROBE_${PROBE_IDX}_TEXT "${PROBE}" "${MCUS}")
                IntegrationTesting_UnlockProbe("${PROBE}")
                set(PROBE_${PROBE_IDX}_USED_BY "")
            else()
                set(PROBE_${PROBE_IDX}_MCUS    "")
                set(PROBE_${PROBE_IDX}_TEXT    "used by ${LOCK_RESULT}")
                set(PROBE_${PROBE_IDX}_USED_BY "${LOCK_RESULT}")
                list(APPEND USED_PROBES "${PROBE} (${LOCK_RESULT})")
            endif()

            # Only the MCUs of this project are identified here - the family of another MCU is not known
            set(PROBE_${PROBE_IDX}_BOARD        "")
            set(PROBE_${PROBE_IDX}_OTHER_FAMILY FALSE)
            math(EXPR PROBE_IDX "${PROBE_IDX} + 1")

        endforeach()

    endif()

    list(LENGTH PROBES PROBES_CNT)

    set(BOARDS "")

    # Boards of the fixtures - a probe configured with its board ("board" of the fixture of the probe, eg. a
    # variant STM32H503xB_Eeprom of another wiring): the preset of the board in the boards file of the project,
    # otherwise the preset of the MCU identified on the probe
    set(PROBE_IDX 0)
    foreach(PROBE IN LISTS PROBES)

        IntegrationTesting_Get_LockKey(PROBE_KEY "${PROBE}")
        set(FIX_BOARD "${IT_FIX_PROBE_${PROBE_KEY}_BOARD}")

        if(NOT "${FIX_BOARD}" STREQUAL "" AND
           "${PROBE_${PROBE_IDX}_USED_BY}" STREQUAL "")

            set(PRESET_PATH boards "${FIX_BOARD}" preset)
            string(JSON FIX_PRESET ERROR_VARIABLE FIX_PRESET_ERROR GET "${OVERRIDE_CONTENT}" ${PRESET_PATH})

            if(FIX_PRESET_ERROR AND
               PROBE_${PROBE_IDX}_MCUS)
                IntegrationTesting_SelectCandidate(FIX_MCU "${IT_PROBE_RS}" "${PROBE_${PROBE_IDX}_MCUS}")
                set(FIX_PRESET "${FIX_MCU}_IntegrationTest")
            elseif(FIX_PRESET_ERROR)
                set(FIX_PRESET "")
            endif()

            # A board of a family that is not in this project (boards of all families of an IT agent) is not an
            # error of the configuration - the probe is listed with the probes without identified MCU
            if("${FIX_PRESET}" STREQUAL "" AND
               PROBE_${PROBE_IDX}_OTHER_FAMILY)
                message(VERBOSE "Probe ${PROBE} is configured as board ${FIX_BOARD} of a family that is not in this "
                                "project (${PROBE_${PROBE_IDX}_TEXT}) - skipped.")
            elseif("${FIX_PRESET}" STREQUAL "")
                message(WARNING "Probe ${PROBE} is configured as board ${FIX_BOARD}, but its MCU is not identified "
                                "(${PROBE_${PROBE_IDX}_TEXT}) and the board has no preset in ${OVERRIDE_FILE} - "
                                "skipped.")
            else()
                set(PROBE_${PROBE_IDX}_BOARD "${FIX_BOARD}")
                if(NOT "${FIX_BOARD}" IN_LIST BOARDS)
                    list(APPEND BOARDS "${FIX_BOARD}")
                    set(BOARD_${FIX_BOARD}_PASS   "PROBES")
                    set(BOARD_${FIX_BOARD}_PRESET "${FIX_PRESET}")
                    set(CACHE_PATH boards "${FIX_BOARD}" cacheVariables)
                    string(JSON CACHE_JSON ERROR_VARIABLE CACHE_ERROR GET "${OVERRIDE_CONTENT}" ${CACHE_PATH})
                    set(BOARD_${FIX_BOARD}_CACHE "${CACHE_JSON}")
                    if(CACHE_ERROR)
                        set(BOARD_${FIX_BOARD}_CACHE "")
                    endif()
                    set(BOARD_${FIX_BOARD}_PROBES "")
                endif()
                list(APPEND BOARD_${FIX_BOARD}_PROBES "${PROBE}")
            endif()

        endif()

        math(EXPR PROBE_IDX "${PROBE_IDX} + 1")

    endforeach()

    # Boards of the project (override)
    if(EXISTS "${OVERRIDE_FILE}")
        string(JSON OVERRIDE_CNT ERROR_VARIABLE OVERRIDE_ERROR LENGTH "${OVERRIDE_CONTENT}" boards)

        if(OVERRIDE_ERROR)
            # A boards file of the project with the fixtures of the probes only
            set(OVERRIDE_CNT 0)
        endif()

        # Boards with probes first, then boards selected by MCU of the probe
        foreach(PASS IN ITEMS PROBES MCU)
            if(OVERRIDE_CNT EQUAL 0)
                break()
            endif()

            math(EXPR OVERRIDE_LAST "${OVERRIDE_CNT} - 1")
            foreach(BOARD_IDX RANGE ${OVERRIDE_LAST})

                string(JSON BOARD MEMBER "${OVERRIDE_CONTENT}" boards ${BOARD_IDX})

                # A board of an IT agent (taken over from its configuration) is no board of this project
                string(JSON BOARD_HOST ERROR_VARIABLE BOARD_HOST_ERROR GET "${OVERRIDE_CONTENT}" boards ${BOARD} host)
                if(NOT BOARD_HOST_ERROR AND
                   NOT "${BOARD_HOST}" STREQUAL "${IT_LOCAL_HOST}")
                    continue()
                endif()

                string(JSON PRESET ERROR_VARIABLE PRESET_ERROR GET "${OVERRIDE_CONTENT}" boards ${BOARD} preset)
                string(JSON BOARD_PROBES_CNT ERROR_VARIABLE BOARD_PROBES_ERROR LENGTH "${OVERRIDE_CONTENT}" boards ${BOARD} probes)

                if(PRESET_ERROR)
                    if(PASS STREQUAL "PROBES")
                        message(WARNING "Board ${BOARD} has no \"preset\" in ${OVERRIDE_FILE} - skipped.")
                    endif()
                    continue()
                endif()

                if(BOARD_PROBES_ERROR)
                    set(BOARD_PROBES_CNT 0)
                endif()

                if(PASS STREQUAL "PROBES" AND BOARD_PROBES_CNT EQUAL 0)
                    continue()
                elseif(PASS STREQUAL "MCU" AND BOARD_PROBES_CNT GREATER 0)
                    continue()
                endif()

                set(BOARD_PROBES "")
                if(BOARD_PROBES_CNT GREATER 0)
                    math(EXPR BOARD_PROBES_LAST "${BOARD_PROBES_CNT} - 1")
                    foreach(BOARD_PROBE_IDX RANGE ${BOARD_PROBES_LAST})
                        string(JSON BOARD_PROBE GET "${OVERRIDE_CONTENT}" boards ${BOARD} probes ${BOARD_PROBE_IDX})
                        list(APPEND BOARD_PROBES "${BOARD_PROBE}")
                    endforeach()
                endif()

                string(REGEX REPLACE "_IntegrationTest$" "" BOARD_MCU "${PRESET}")

                set(PROBE_IDX 0)
                foreach(PROBE IN LISTS PROBES)
                    if(NOT PROBE_${PROBE_IDX}_BOARD)
                        set(IS_BOARD_PROBE FALSE)

                        if(PASS STREQUAL "PROBES")
                            foreach(BOARD_PROBE IN LISTS BOARD_PROBES)
                                if(PROBE STREQUAL BOARD_PROBE OR PROBE MATCHES ":${BOARD_PROBE}$")
                                    set(IS_BOARD_PROBE TRUE)
                                endif()
                            endforeach()
                        elseif("${BOARD_MCU}" IN_LIST PROBE_${PROBE_IDX}_MCUS)
                            set(IS_BOARD_PROBE TRUE)
                        endif()

                        if(IS_BOARD_PROBE)
                            set(PROBE_${PROBE_IDX}_BOARD "${BOARD}")
                            if(NOT "${BOARD}" IN_LIST BOARDS)
                                list(APPEND BOARDS "${BOARD}")
                                set(BOARD_${BOARD}_PASS   "${PASS}")
                                set(BOARD_${BOARD}_PRESET "${PRESET}")
                                string(JSON BOARD_${BOARD}_CACHE ERROR_VARIABLE CACHE_ERROR
                                       GET "${OVERRIDE_CONTENT}" boards ${BOARD} cacheVariables)
                                if(CACHE_ERROR)
                                    set(BOARD_${BOARD}_CACHE "")
                                endif()
                                set(BOARD_${BOARD}_PROBES "")
                            endif()
                            list(APPEND BOARD_${BOARD}_PROBES "${PROBE}")
                        endif()
                    endif()
                    math(EXPR PROBE_IDX "${PROBE_IDX} + 1")
                endforeach()

            endforeach()
        endforeach()
    endif()

    # Other identified probes - board named by the MCU
    set(NOT_IDENTIFIED "")
    set(PROBE_IDX 0)
    foreach(PROBE IN LISTS PROBES)
        if(NOT PROBE_${PROBE_IDX}_BOARD)
            if(PROBE_${PROBE_IDX}_MCUS)
                IntegrationTesting_SelectCandidate(BOARD "${IT_PROBE_RS}" "${PROBE_${PROBE_IDX}_MCUS}")
                list(LENGTH PROBE_${PROBE_IDX}_MCUS MCUS_CNT)

                if(MCUS_CNT GREATER 1)
                    list(JOIN PROBE_${PROBE_IDX}_MCUS ", " CANDIDATES_TEXT)
                    message(WARNING "Probe ${PROBE} (${PROBE_${PROBE_IDX}_TEXT}) matches more MCUs: ${CANDIDATES_TEXT} - "
                                    "${BOARD} is used (first one known by probe-rs). Define the board (preset) in ${OVERRIDE_FILE}.")
                endif()

                set(PROBE_${PROBE_IDX}_BOARD "${BOARD}")
                if(NOT "${BOARD}" IN_LIST BOARDS)
                    list(APPEND BOARDS "${BOARD}")
                    set(BOARD_${BOARD}_PASS   "MCU")
                    set(BOARD_${BOARD}_PRESET "${BOARD}_IntegrationTest")
                    set(BOARD_${BOARD}_CACHE  "")
                    set(BOARD_${BOARD}_PROBES "")
                endif()
                list(APPEND BOARD_${BOARD}_PROBES "${PROBE}")
            elseif("${PROBE_${PROBE_IDX}_USED_BY}" STREQUAL "")
                list(APPEND NOT_IDENTIFIED "${PROBE} (${PROBE_${PROBE_IDX}_TEXT})")
            else()
                # Used by another client - reported in USED_PROBES
            endif()
        endif()
        math(EXPR PROBE_IDX "${PROBE_IDX} + 1")
    endforeach()

    # Boards file of connected boards - boards (configuration of the firmware), targets (one
    # physical board per probe), probes used by another client
    set(OUT_JSON "{ \"boards\": {}, \"targets\": [], \"used\": [] }")
    set(TARGET_IDX 0)

    message("Connected boards:")

    if(NOT BOARDS)
        message("  none")
    endif()

    foreach(BOARD IN LISTS BOARDS)

        set(PROBES_JSON "")
        set(PROBES_TEXT "")
        foreach(PROBE IN LISTS BOARD_${BOARD}_PROBES)

            list(APPEND PROBES_JSON "\"${PROBE}\"")
            list(FIND PROBES "${PROBE}" PROBE_IDX)
            itDetect_Get_ProbeName(PROBE_NAME "${PROBE}" "${BOARD}")
            list(APPEND PROBES_TEXT "${PROBE} ${PROBE_NAME} (${PROBE_${PROBE_IDX}_TEXT})")

            IntegrationTesting_JsonString(BOARD_JSON "${BOARD}")
            IntegrationTesting_JsonString(PROBE_JSON "${PROBE}")
            IntegrationTesting_JsonString(NAME_JSON  "${PROBE_NAME}")
            IntegrationTesting_JsonString(HOST_JSON  "${IT_LOCAL_HOST}")
            set(TARGET_JSON "{ \"board\": ${BOARD_JSON}, \"probe\": ${PROBE_JSON}, \"host\": ${HOST_JSON}, \"label\": ${NAME_JSON} }")
            string(JSON OUT_JSON SET "${OUT_JSON}" targets ${TARGET_IDX} "${TARGET_JSON}")
            math(EXPR TARGET_IDX "${TARGET_IDX} + 1")

        endforeach()
        list(JOIN PROBES_JSON ", " PROBES_JSON)
        list(JOIN PROBES_TEXT ", " PROBES_TEXT)
        list(LENGTH BOARD_${BOARD}_PROBES BOARD_PROBES_CNT)

        string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" "{}")
        string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" preset "\"${BOARD_${BOARD}_PRESET}\"")
        string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" probes "[ ${PROBES_JSON} ]")
        if(BOARD_${BOARD}_CACHE)
            string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" cacheVariables "${BOARD_${BOARD}_CACHE}")
        endif()

        # Fixture of the board (wiring, attached ICs): the boards file of the project, the fixture of the board,
        # the fixture of its probes - one firmware per board, probes with other features are reported
        string(JSON BOARD_FEATURES ERROR_VARIABLE FEATURES_ERROR GET "${OVERRIDE_CONTENT}" boards "${BOARD}" features)
        if(FEATURES_ERROR)
            set(BOARD_FEATURES "${IT_FIX_BOARD_${BOARD}_FEATURES}")
        endif()

        foreach(PROBE IN LISTS BOARD_${BOARD}_PROBES)

            IntegrationTesting_Get_LockKey(PROBE_KEY "${PROBE}")
            set(PROBE_FEATURES "${IT_FIX_PROBE_${PROBE_KEY}_FEATURES}")

            if("${PROBE_FEATURES}" STREQUAL "")
                continue()
            endif()

            if("${BOARD_FEATURES}" STREQUAL "")
                set(BOARD_FEATURES "${PROBE_FEATURES}")
            else()
                string(JSON FEATURES_EQUAL EQUAL "${BOARD_FEATURES}" "${PROBE_FEATURES}")
                if(NOT FEATURES_EQUAL)
                    message(WARNING "Probe ${PROBE} of board ${BOARD} has other features than the board "
                                    "(${PROBE_FEATURES}) - one firmware is built for a board, give the board of the "
                                    "probe a name of its own.")
                endif()
            endif()

        endforeach()

        set(FEATURES_TEXT "")
        if(NOT "${BOARD_FEATURES}" STREQUAL "")
            string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" features "${BOARD_FEATURES}")
            itDetect_Get_FeatureNames(FEATURE_NAMES "${BOARD_FEATURES}")
            set(FEATURES_TEXT " [${FEATURE_NAMES}]")
        endif()

        # Own defines of the board (builds of the board): the boards file of the project, the board, its probes -
        # one firmware per board, probes with other defines are reported
        string(JSON BOARD_DEFINES ERROR_VARIABLE DEFINES_ERROR GET "${OVERRIDE_CONTENT}" boards "${BOARD}" defines)
        if(DEFINES_ERROR)
            set(BOARD_DEFINES "${IT_FIX_BOARD_${BOARD}_DEFINES}")
        endif()

        foreach(PROBE IN LISTS BOARD_${BOARD}_PROBES)
            IntegrationTesting_Get_LockKey(PROBE_KEY "${PROBE}")
            set(PROBE_DEFINES "${IT_FIX_PROBE_${PROBE_KEY}_DEFINES}")
            if("${PROBE_DEFINES}" STREQUAL "")
                continue()
            endif()
            if("${BOARD_DEFINES}" STREQUAL "")
                set(BOARD_DEFINES "${PROBE_DEFINES}")
            else()
                string(JSON DEFINES_EQUAL EQUAL "${BOARD_DEFINES}" "${PROBE_DEFINES}")
                if(NOT DEFINES_EQUAL)
                    message(WARNING "Probe ${PROBE} of board ${BOARD} has other defines than the board "
                                    "(${PROBE_DEFINES}) - one firmware is built for a board, give the board of the "
                                    "probe a name of its own.")
                endif()
            endif()
        endforeach()

        if(NOT "${BOARD_DEFINES}" STREQUAL "")
            string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" defines "${BOARD_DEFINES}")
        endif()

        # More probes of one MCU without the probes of the board in the boards file of the project:
        # the boards may have a different wiring, a test run selects one of them explicitly
        if(BOARD_PROBES_CNT GREATER 1 AND
           NOT "${BOARD_${BOARD}_PASS}" STREQUAL "PROBES")
            string(JSON OUT_JSON SET "${OUT_JSON}" boards "${BOARD}" ambiguous "true")
            message(WARNING "${BOARD_PROBES_CNT} probes of ${BOARD} are connected - every run selects one of them "
                            "(INTEGRATION_TEST_PROBE). Boards with a different wiring get a name of their own with their "
                            "probe in ${OVERRIDE_FILE} (IT_BOARD_<name> of the test sets).")
        endif()

        if(NOT "${BOARD_${BOARD}_PRESET}" IN_LIST IT_PRESETS)
            message(WARNING "Preset ${BOARD_${BOARD}_PRESET} of board ${BOARD} is not in ${PROJECT_PRESETS_FILE}.")
        endif()

        message("  ${BOARD} (${BOARD_${BOARD}_PRESET})${FEATURES_TEXT}: ${PROBES_TEXT}")

    endforeach()

    set(USED_IDX 0)
    set(PROBE_IDX 0)
    foreach(PROBE IN LISTS PROBES)
        if(NOT "${PROBE_${PROBE_IDX}_USED_BY}" STREQUAL "")
            IntegrationTesting_JsonString(PROBE_JSON "${PROBE}")
            IntegrationTesting_JsonString(USED_JSON  "${PROBE_${PROBE_IDX}_USED_BY}")
            string(JSON OUT_JSON SET "${OUT_JSON}" used ${USED_IDX} "{ \"probe\": ${PROBE_JSON}, \"usedBy\": ${USED_JSON} }")
            math(EXPR USED_IDX "${USED_IDX} + 1")
        endif()
        math(EXPR PROBE_IDX "${PROBE_IDX} + 1")
    endforeach()

    if(NOT_IDENTIFIED)
        message("Probes without identified MCU (not used):")
        foreach(PROBE_TEXT IN LISTS NOT_IDENTIFIED)
            message("  ${PROBE_TEXT}")
        endforeach()
    endif()

    # New boards: a probe with a serial number that no board configuration has (ItBoards.json of the project, the
    # configuration of an IT agent) - its decoded MCU is listed, the board is to be configured
    set(NEW_BOARDS "")
    set(PROBE_IDX 0)
    foreach(PROBE IN LISTS PROBES)
        IntegrationTesting_Get_LockKey(PROBE_KEY "${PROBE}")
        if("${PROBE}" MATCHES "^[0-9A-Fa-f]+:[0-9A-Fa-f]+:.+$" AND
           "${PROBE_${PROBE_IDX}_USED_BY}" STREQUAL "" AND
           NOT "${PROBE_KEY}" IN_LIST IT_FIX_PROBE_KEYS)
            set(NEW_TEXT "${PROBE_${PROBE_IDX}_TEXT}")
            if(NOT "${PROBE_${PROBE_IDX}_BOARD}" STREQUAL "")
                set(NEW_TEXT "${PROBE_${PROBE_IDX}_BOARD}, ${NEW_TEXT}")
            endif()
            list(APPEND NEW_BOARDS "${PROBE} (${NEW_TEXT})")
        endif()
        math(EXPR PROBE_IDX "${PROBE_IDX} + 1")
    endforeach()

    if(NEW_BOARDS)
        message("New boards (serial number not in the board configuration):")
        foreach(PROBE_TEXT IN LISTS NEW_BOARDS)
            message("  ${PROBE_TEXT}")
        endforeach()
    endif()

    if(USED_PROBES)
        message("Probes used by another client (not read):")
        foreach(PROBE_TEXT IN LISTS USED_PROBES)
            message("  ${PROBE_TEXT}")
        endforeach()
    endif()

    if(PROBES_CNT EQUAL 0)
        message("No debug probe is connected.")
    endif()

    get_filename_component(OUT_DIR "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${OUT_DIR}")
    file(WRITE "${OUT_FILE}" "${OUT_JSON}\n")

endfunction(IntegrationTesting_DetectBoards)

#------------------------------------------------------------------------------#
# Updates the boards of an IT agent in the board configuration of the project
# (ItBoards.json) from the board configuration of the agent: every board of the
# agent is taken over with "host": "<host>" (the configuration of the agent
# replaces it), a board of the host that the agent no longer has gets
# "stale": true (not used any more); the boards of this machine and of other
# agents are not touched. The file is written only when it changes.
#
# OVERRIDE_FILE [in]: ItBoards.json of the project (created when the agent has boards)
# HOST          [in]: Name of the host (ItHosts.json)
# CONFIG_JSON   [in]: Board configuration of the agent ({ "probes": {...}, "boards": {...} })
#------------------------------------------------------------------------------#
function(itDetect_UpdateRemoteBoards OVERRIDE_FILE HOST CONFIG_JSON)

    set(CONTENT "{}")
    if(EXISTS "${OVERRIDE_FILE}")
        file(READ "${OVERRIDE_FILE}" CONTENT)
    endif()
    set(OLD_CONTENT "${CONTENT}")
    set(AGENT_BOARDS_CNT 0)

    IntegrationTesting_JsonString(HOST_JSON "${HOST}")
    get_filename_component(OVERRIDE_NAME "${OVERRIDE_FILE}" NAME)

    foreach(SECTION IN ITEMS probes boards)

        string(JSON SECTION_TYPE ERROR_VARIABLE SECTION_ERROR TYPE "${CONTENT}" ${SECTION})
        if(SECTION_ERROR)
            string(JSON CONTENT SET "${CONTENT}" ${SECTION} "{}")
        endif()

        # The boards of the agent - taken over with the host
        set(AGENT_KEYS "")
        string(JSON AGENT_CNT ERROR_VARIABLE AGENT_ERROR LENGTH "${CONFIG_JSON}" ${SECTION})
        if(AGENT_ERROR)
            set(AGENT_CNT 0)
        endif()

        set(AGENT_IDX 0)
        while(AGENT_IDX LESS AGENT_CNT)

            string(JSON KEY MEMBER "${CONFIG_JSON}" ${SECTION} ${AGENT_IDX})
            string(JSON ENTRY GET "${CONFIG_JSON}" ${SECTION} "${KEY}")
            string(JSON ENTRY SET "${ENTRY}" host "${HOST_JSON}")
            list(APPEND AGENT_KEYS "${KEY}")
            math(EXPR AGENT_BOARDS_CNT "${AGENT_BOARDS_CNT} + 1")

            string(JSON KNOWN_HOST ERROR_VARIABLE KNOWN_ERROR GET "${CONTENT}" ${SECTION} "${KEY}" host)
            string(JSON KNOWN ERROR_VARIABLE KNOWN_ENTRY_ERROR GET "${CONTENT}" ${SECTION} "${KEY}")
            if(KNOWN_ERROR)
                set(KNOWN_HOST "${IT_LOCAL_HOST}")
            endif()

            if(NOT KNOWN_ENTRY_ERROR AND
               NOT "${KNOWN_HOST}" STREQUAL "${HOST}")
                if("${SECTION}" STREQUAL "boards")
                    # A board (without a serial number) of this name is configured for another host
                    message(WARNING "Board ${KEY} of the IT agent ${HOST} is configured for ${KNOWN_HOST} in "
                                    "${OVERRIDE_NAME} - not taken over, give one of them a name of its own.")
                    math(EXPR AGENT_IDX "${AGENT_IDX} + 1")
                    continue()
                endif()
                message(WARNING "Probe ${KEY} of ${OVERRIDE_NAME} (host ${KNOWN_HOST}) is a board of the IT agent "
                                "${HOST} - the configuration of the agent replaces it.")
            endif()

            string(JSON CONTENT SET "${CONTENT}" ${SECTION} "${KEY}" "${ENTRY}")
            math(EXPR AGENT_IDX "${AGENT_IDX} + 1")

        endwhile()

        # The boards of the host the agent no longer has - stale
        string(JSON KNOWN_CNT LENGTH "${CONTENT}" ${SECTION})
        set(KNOWN_IDX 0)
        while(KNOWN_IDX LESS KNOWN_CNT)

            string(JSON KEY MEMBER "${CONTENT}" ${SECTION} ${KNOWN_IDX})
            string(JSON KNOWN_HOST ERROR_VARIABLE KNOWN_ERROR GET "${CONTENT}" ${SECTION} "${KEY}" host)

            if(NOT KNOWN_ERROR AND
               "${KNOWN_HOST}" STREQUAL "${HOST}" AND
               NOT "${KEY}" IN_LIST AGENT_KEYS)
                string(JSON CONTENT SET "${CONTENT}" ${SECTION} "${KEY}" stale "true")
            endif()

            math(EXPR KNOWN_IDX "${KNOWN_IDX} + 1")

        endwhile()

    endforeach()

    string(JSON UNCHANGED ERROR_VARIABLE COMPARE_ERROR EQUAL "${OLD_CONTENT}" "${CONTENT}")

    if(COMPARE_ERROR)
        set(UNCHANGED FALSE)
    endif()

    # A new file only for an agent with boards
    set(WRITE_FILE FALSE)
    if(NOT UNCHANGED)
        if(EXISTS "${OVERRIDE_FILE}" OR
           AGENT_BOARDS_CNT GREATER 0)
            set(WRITE_FILE TRUE)
        endif()
    endif()

    if(WRITE_FILE)
        file(WRITE "${OVERRIDE_FILE}" "${CONTENT}\n")
        message(STATUS "${OVERRIDE_NAME}: boards of the IT agent ${HOST} updated from its configuration")
    endif()

endfunction(itDetect_UpdateRemoteBoards)

#------------------------------------------------------------------------------#
# Detects the boards of an IT agent over the IT agent interface: embi-agent
# detect of the agent reads its probes (probe-rs of the version of this machine,
# identification of the MCUs of all families) and returns them with the board
# configuration of the agent; the boards are formed here with the presets of
# this project (IntegrationTesting_DetectBoards).
#
# BOARDS_JSON_VAR  [out]: Boards file of the agent ("" if the detection failed - reported)
# ERROR_VAR        [out]: Why the detection failed ("" = done)
# PROJECT_DIR      [in]:  Project root folder
# MCU_PRESETS_FILE [in]:  Ral presets with MCU identification
# OVERRIDE_FILE    [in]:  Boards file of the project (may not exist)
# WORK_DIR         [in]:  Folder of the boards file of the agent (Build of the project)
# HOST             [in]:  Name of the host (IntegrationTesting_ReadItHosts)
# PROBE_RS_VERSION [in]:  Version of probe-rs of this machine
#------------------------------------------------------------------------------#
function(itDetect_DetectHost BOARDS_JSON_VAR
                             ERROR_VAR
                             PROJECT_DIR
                             MCU_PRESETS_FILE
                             OVERRIDE_FILE
                             WORK_DIR
                             HOST
                             PROBE_RS_VERSION)

    set(TARGET    "${IT_HOST_${HOST}_TARGET}")
    set(HOST_FILE "${WORK_DIR}/IntegrationTestBoards_${HOST}.json")

    file(REMOVE "${HOST_FILE}")

    message("IT agent ${HOST} (${TARGET}):")

    IntegrationTesting_Get_LockHolder(HOLDER "detection of connected boards")

    IntegrationTesting_AgentCall(AGENT_JSON
                                 AGENT_ERROR
                                 "${TARGET}"
                                 "${IT_HOST_${HOST}_TOOLS}"
                                 ""
                                 detect
                                 --probe-rs
                                 "${PROBE_RS_VERSION}"
                                 --holder
                                 "${HOLDER}")

    set(BOARDS_JSON "")

    if("${AGENT_ERROR}" STREQUAL "")
        string(JSON AGENT_CONFIG GET "${AGENT_JSON}" config)
        itDetect_UpdateRemoteBoards("${OVERRIDE_FILE}" "${HOST}" "${AGENT_CONFIG}")
        IntegrationTesting_DetectBoards("${PROJECT_DIR}"
                                        "${MCU_PRESETS_FILE}"
                                        "${OVERRIDE_FILE}"
                                        "${HOST_FILE}"
                                        "${AGENT_JSON}")
        file(READ "${HOST_FILE}" BOARDS_JSON)
    else()
        message(WARNING "Detection of the boards of ${HOST} (${TARGET}) failed: ${AGENT_ERROR} - its boards are not "
                        "listed.")
    endif()

    set(${BOARDS_JSON_VAR} "${BOARDS_JSON}" PARENT_SCOPE)
    set(${ERROR_VAR}       "${AGENT_ERROR}" PARENT_SCOPE)

endfunction(itDetect_DetectHost)

#------------------------------------------------------------------------------#
# Appends an element to an array of a JSON object.
#
# JSON_VAR [in,out]: JSON object
# ARRAY    [in]:     Member with the array
# ELEMENT  [in]:     JSON of the element
#------------------------------------------------------------------------------#
function(itDetect_JsonAppend JSON_VAR ARRAY ELEMENT)

    string(JSON ELEMENTS_CNT ERROR_VARIABLE ELEMENTS_ERROR LENGTH "${${JSON_VAR}}" ${ARRAY})

    if(ELEMENTS_ERROR)
        string(JSON JSON SET "${${JSON_VAR}}" ${ARRAY} "[ ${ELEMENT} ]")
    else()
        string(JSON JSON SET "${${JSON_VAR}}" ${ARRAY} ${ELEMENTS_CNT} "${ELEMENT}")
    endif()

    set(${JSON_VAR} "${JSON}" PARENT_SCOPE)

endfunction(itDetect_JsonAppend)

#------------------------------------------------------------------------------#
# Adds the boards of an IT agent to the boards file of connected boards: a
# board only of the agent gets the preset and the parameters without probes
# (the "probes" of a board are the probes of this machine), every target and
# every used probe of the agent gets the members "host" and "target".
#
# MERGED_VAR [in,out]: Boards file of connected boards (JSON)
# HOST_JSON  [in]:     Boards file of the agent
# HOST       [in]:     Name of the host
# TARGET     [in]:     SSH target of the host
#------------------------------------------------------------------------------#
function(itDetect_MergeHost MERGED_VAR HOST_JSON HOST TARGET)

    set(MERGED "${${MERGED_VAR}}")

    IntegrationTesting_JsonString(HOST_NAME_JSON "${HOST}")
    IntegrationTesting_JsonString(TARGET_JSON "${TARGET}")

    string(JSON BOARDS_CNT ERROR_VARIABLE BOARDS_ERROR LENGTH "${HOST_JSON}" boards)
    if(NOT BOARDS_ERROR AND
       BOARDS_CNT GREATER 0)
        math(EXPR BOARDS_LAST "${BOARDS_CNT} - 1")
        foreach(BOARD_IDX RANGE ${BOARDS_LAST})
            string(JSON BOARD MEMBER "${HOST_JSON}" boards ${BOARD_IDX})
            string(JSON KNOWN ERROR_VARIABLE KNOWN_ERROR GET "${MERGED}" boards "${BOARD}")

            # One firmware per board name - a board of this machine and of the agent with other features
            string(JSON KNOWN_FEATURES ERROR_VARIABLE KNOWN_FEATURES_ERROR GET "${MERGED}" boards "${BOARD}" features)
            string(JSON HOST_FEATURES ERROR_VARIABLE HOST_FEATURES_ERROR GET "${HOST_JSON}" boards "${BOARD}" features)
            if(KNOWN_FEATURES_ERROR)
                set(KNOWN_FEATURES "{}")
            endif()
            if(HOST_FEATURES_ERROR)
                set(HOST_FEATURES "{}")
            endif()
            string(JSON FEATURES_EQUAL EQUAL "${KNOWN_FEATURES}" "${HOST_FEATURES}")
            if(NOT KNOWN_ERROR AND
               NOT FEATURES_EQUAL)
                message(WARNING "Board ${BOARD} of ${HOST} has other features than the board ${BOARD} of this "
                                "machine - the configuration of this machine is used, give one of the boards a "
                                "name of its own.")
            endif()

            if(KNOWN_ERROR)
                string(JSON BOARD_JSON GET "${HOST_JSON}" boards "${BOARD}")
                string(JSON BOARD_JSON SET "${BOARD_JSON}" probes "[]")
                string(JSON AMBIGUOUS ERROR_VARIABLE AMBIGUOUS_ERROR GET "${BOARD_JSON}" ambiguous)
                if(NOT AMBIGUOUS_ERROR)
                    string(JSON BOARD_JSON REMOVE "${BOARD_JSON}" ambiguous)
                endif()
                string(JSON MERGED SET "${MERGED}" boards "${BOARD}" "${BOARD_JSON}")
            endif()
        endforeach()
    endif()

    foreach(ARRAY IN ITEMS targets used)
        string(JSON ELEMENTS_CNT ERROR_VARIABLE ELEMENTS_ERROR LENGTH "${HOST_JSON}" ${ARRAY})
        if(NOT ELEMENTS_ERROR AND
           ELEMENTS_CNT GREATER 0)
            math(EXPR ELEMENTS_LAST "${ELEMENTS_CNT} - 1")
            foreach(ELEMENT_IDX RANGE ${ELEMENTS_LAST})
                string(JSON ELEMENT GET "${HOST_JSON}" ${ARRAY} ${ELEMENT_IDX})
                string(JSON ELEMENT SET "${ELEMENT}" host "${HOST_NAME_JSON}")
                string(JSON ELEMENT SET "${ELEMENT}" target "${TARGET_JSON}")
                itDetect_JsonAppend(MERGED ${ARRAY} "${ELEMENT}")
            endforeach()
        endif()
    endforeach()

    set(${MERGED_VAR} "${MERGED}" PARENT_SCOPE)

endfunction(itDetect_MergeHost)

#------------------------------------------------------------------------------#
# Keeps the targets of the probes used by another client: a probe that is not
# read by the detection (debugging, tests, pipeline job) gets its target of the
# previous detection with the member "usedBy" (the board is still listed, eg.
# to be picked when it is free again).
#
# MERGED_VAR    [in,out]: Boards file of connected boards (JSON)
# PREVIOUS_JSON [in]:     Boards file of the previous detection ("" = none)
#------------------------------------------------------------------------------#
function(itDetect_KeepUsedTargets MERGED_VAR PREVIOUS_JSON)

    set(MERGED "${${MERGED_VAR}}")

    string(JSON USED_CNT ERROR_VARIABLE USED_ERROR LENGTH "${MERGED}" used)
    string(JSON PREVIOUS_CNT ERROR_VARIABLE PREVIOUS_ERROR LENGTH "${PREVIOUS_JSON}" targets)

    if(NOT USED_ERROR AND
       NOT PREVIOUS_ERROR AND
       USED_CNT GREATER 0 AND
       PREVIOUS_CNT GREATER 0)

        math(EXPR USED_LAST "${USED_CNT} - 1")
        math(EXPR PREVIOUS_LAST "${PREVIOUS_CNT} - 1")

        foreach(USED_IDX RANGE ${USED_LAST})

            string(JSON USED_PROBE GET "${MERGED}" used ${USED_IDX} probe)
            string(JSON USED_BY    GET "${MERGED}" used ${USED_IDX} usedBy)
            string(JSON USED_HOST ERROR_VARIABLE HOST_ERROR GET "${MERGED}" used ${USED_IDX} host)
            if(HOST_ERROR)
                set(USED_HOST "${IT_LOCAL_HOST}")
            endif()

            foreach(PREVIOUS_IDX RANGE ${PREVIOUS_LAST})
                string(JSON PREVIOUS_PROBE GET "${PREVIOUS_JSON}" targets ${PREVIOUS_IDX} probe)
                string(JSON PREVIOUS_HOST  GET "${PREVIOUS_JSON}" targets ${PREVIOUS_IDX} host)
                if("${PREVIOUS_PROBE}" STREQUAL "${USED_PROBE}" AND
                   "${PREVIOUS_HOST}" STREQUAL "${USED_HOST}")

                    string(JSON ELEMENT GET "${PREVIOUS_JSON}" targets ${PREVIOUS_IDX})
                    IntegrationTesting_JsonString(USED_JSON "${USED_BY}")
                    string(JSON ELEMENT SET "${ELEMENT}" usedBy "${USED_JSON}")
                    itDetect_JsonAppend(MERGED targets "${ELEMENT}")

                    # The board of the target (its only probe is the used one) - from the previous detection
                    string(JSON BOARD GET "${ELEMENT}" board)
                    string(JSON KNOWN ERROR_VARIABLE KNOWN_ERROR GET "${MERGED}" boards "${BOARD}")
                    string(JSON BOARD_JSON ERROR_VARIABLE BOARD_ERROR GET "${PREVIOUS_JSON}" boards "${BOARD}")
                    if(KNOWN_ERROR AND
                       NOT BOARD_ERROR)
                        if(NOT "${USED_HOST}" STREQUAL "${IT_LOCAL_HOST}")
                            string(JSON BOARD_JSON SET "${BOARD_JSON}" probes "[]")
                        endif()
                        string(JSON MERGED SET "${MERGED}" boards "${BOARD}" "${BOARD_JSON}")
                    endif()

                    break()

                endif()
            endforeach()

        endforeach()

    endif()

    set(${MERGED_VAR} "${MERGED}" PARENT_SCOPE)

endfunction(itDetect_KeepUsedTargets)

#------------------------------------------------------------------------------#
# Detects the boards connected to this machine and to every IT agent of
# ItHosts.json (IntegrationTesting_Remote.cmake) and writes one boards file of
# connected boards:
#   boards   configuration of every board (preset, parameters, the probes of
#            this machine) - a board only of an agent has no probes here
#   targets  one physical board per probe: board, probe, host ("local" = this
#            machine, otherwise the name of ItHosts.json), target (SSH target),
#            label (name of the board behind the probe), usedBy (the probe is
#            used by another client, target of the previous detection)
#   used     probes used by another client (not read)
#   failed   IT agents whose detection failed: host, target, error (only when
#            there is one)
#
# PROJECT_DIR      [in]: Project root folder (CMakePresets.json, ItHosts.json)
# MCU_PRESETS_FILE [in]: Ral presets with MCU identification
# OVERRIDE_FILE    [in]: Boards file of the project (may not exist)
# OUT_FILE         [in]: Boards file of connected boards
#------------------------------------------------------------------------------#
function(IntegrationTesting_DetectAllBoards PROJECT_DIR MCU_PRESETS_FILE OVERRIDE_FILE OUT_FILE)

    get_filename_component(OUT_DIR "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${OUT_DIR}")

    # The board configuration of the project had another name
    if(EXISTS "${PROJECT_DIR}/${IT_PROJECT_BOARDS_OLD_NAME}" AND
       NOT EXISTS "${OVERRIDE_FILE}")
        message(WARNING "${IT_PROJECT_BOARDS_OLD_NAME} of the project is not read any more - the board configuration "
                        "of the project is ${IT_PROJECT_BOARDS_NAME} (rename the file).")
    endif()

    set(PREVIOUS_JSON "")
    if(EXISTS "${OUT_FILE}")
        file(READ "${OUT_FILE}" PREVIOUS_JSON)
    endif()

    set(LOCAL_FILE "${OUT_DIR}/IntegrationTestBoards_${IT_LOCAL_HOST}.json")
    IntegrationTesting_DetectBoards("${PROJECT_DIR}" "${MCU_PRESETS_FILE}" "${OVERRIDE_FILE}" "${LOCAL_FILE}")
    file(READ "${LOCAL_FILE}" MERGED_JSON)

    IntegrationTesting_ReadItHosts(HOSTS "${PROJECT_DIR}")

    if(HOSTS)

        # The agents use probe-rs of the version of this machine
        IntegrationTesting_ProvideProbeRs(LOCAL_PROBE_RS "${PROJECT_DIR}")
        IntegrationTesting_Get_ProbeRsVersion(PROBE_RS_VERSION "${LOCAL_PROBE_RS}")

        set(FAILED_HOSTS "")

        foreach(HOST IN LISTS HOSTS)
            itDetect_DetectHost(HOST_JSON
                                HOST_ERROR
                                "${PROJECT_DIR}"
                                "${MCU_PRESETS_FILE}"
                                "${OVERRIDE_FILE}"
                                "${OUT_DIR}"
                                "${HOST}"
                                "${PROBE_RS_VERSION}")
            if(NOT "${HOST_JSON}" STREQUAL "")
                itDetect_MergeHost(MERGED_JSON "${HOST_JSON}" "${HOST}" "${IT_HOST_${HOST}_TARGET}")
            endif()
            if(NOT "${HOST_ERROR}" STREQUAL "")
                # One line (the log of ssh in the error)
                string(REGEX REPLACE "[\r\n\t]+" " " HOST_ERROR "${HOST_ERROR}")
                IntegrationTesting_JsonString(HOST_NAME_JSON "${HOST}")
                IntegrationTesting_JsonString(HOST_TARGET_JSON "${IT_HOST_${HOST}_TARGET}")
                IntegrationTesting_JsonString(HOST_ERROR_JSON "${HOST_ERROR}")
                list(APPEND FAILED_HOSTS
                     "{ \"host\": ${HOST_NAME_JSON}, \"target\": ${HOST_TARGET_JSON}, \"error\": ${HOST_ERROR_JSON} }")
            endif()
        endforeach()

    endif()

    itDetect_KeepUsedTargets(MERGED_JSON "${PREVIOUS_JSON}")

    # The IT agents whose boards are not listed - the inputs of VS Code report them
    foreach(FAILED_HOST IN LISTS FAILED_HOSTS)
        itDetect_JsonAppend(MERGED_JSON failed "${FAILED_HOST}")
    endforeach()

    file(WRITE "${OUT_FILE}" "${MERGED_JSON}\n")

endfunction(IntegrationTesting_DetectAllBoards)

#------------------------------------------------------------------------------#
# ID of a target (physical board): <board>@<host>:<probe selector>.
#
# ID_VAR [out]: ID
# BOARD  [in]:  Board
# HOST   [in]:  Host ("local" = this machine)
# PROBE  [in]:  probe-rs selector
#------------------------------------------------------------------------------#
function(IntegrationTesting_Get_TargetId ID_VAR BOARD HOST PROBE)

    set(${ID_VAR} "${BOARD}@${HOST}:${PROBE}" PARENT_SCOPE)

endfunction(IntegrationTesting_Get_TargetId)

#------------------------------------------------------------------------------#
# Reads the targets (physical boards) of the boards file of connected boards.
# For every target <idx> (0, 1, ...) sets in the parent scope:
#   IT_TARGET_<idx>_ID, _BOARD, _PRESET, _HOST, _TARGET (SSH target, "" = this
#   machine), _PROBE, _LABEL, _USED_BY, _FEATURES (names of the features of the
#   fixture of the board, "" = no fixture), _TEXT (text of the target for lists)
#   - the suffixes are IT_TARGET_SUFFIXES
#
# COUNT_VAR   [out]: Count of the targets
# BOARDS_FILE [in]:  Boards file of connected boards
#------------------------------------------------------------------------------#
function(IntegrationTesting_ReadTargets COUNT_VAR BOARDS_FILE)

    set(TARGETS_CNT 0)

    if(EXISTS "${BOARDS_FILE}")

        file(READ "${BOARDS_FILE}" BOARDS_CONTENT)
        string(JSON TARGETS_CNT ERROR_VARIABLE TARGETS_ERROR LENGTH "${BOARDS_CONTENT}" targets)

        if(TARGETS_ERROR)
            set(TARGETS_CNT 0)
        endif()

        if(TARGETS_CNT GREATER 0)

            math(EXPR TARGETS_LAST "${TARGETS_CNT} - 1")

            foreach(TARGET_IDX RANGE ${TARGETS_LAST})

                foreach(ITEM IN ITEMS board:BOARD host:HOST target:TARGET probe:PROBE label:LABEL usedBy:USED_BY)
                    string(REPLACE ":" ";" ITEM "${ITEM}")
                    list(GET ITEM 0 KEY)
                    list(GET ITEM 1 SUFFIX)
                    string(JSON VALUE ERROR_VARIABLE VALUE_ERROR GET "${BOARDS_CONTENT}" targets ${TARGET_IDX} ${KEY})
                    if(VALUE_ERROR)
                        set(VALUE "")
                    endif()
                    set(T_${SUFFIX} "${VALUE}")
                endforeach()

                string(JSON T_PRESET ERROR_VARIABLE PRESET_ERROR GET "${BOARDS_CONTENT}" boards "${T_BOARD}" preset)
                if(PRESET_ERROR)
                    set(T_PRESET "")
                endif()

                # Features of the fixture of the board ("" = the board has no fixture)
                set(T_FEATURES "")
                set(FEATURES_PATH boards "${T_BOARD}" features)
                string(JSON FEATURES_JSON ERROR_VARIABLE FEATURES_ERROR GET "${BOARDS_CONTENT}" ${FEATURES_PATH})
                if(NOT FEATURES_ERROR)
                    itDetect_Get_FeatureNames(T_FEATURES "${FEATURES_JSON}")
                endif()

                IntegrationTesting_Get_TargetId(T_ID "${T_BOARD}" "${T_HOST}" "${T_PROBE}")

                if("${T_HOST}" STREQUAL "${IT_LOCAL_HOST}")
                    set(T_TEXT "${T_BOARD} - ${T_LABEL}")
                else()
                    set(T_TEXT "${T_BOARD} - ${T_LABEL} @ ${T_HOST}")
                endif()

                if(NOT "${T_FEATURES}" STREQUAL "")
                    string(APPEND T_TEXT " [${T_FEATURES}]")
                endif()

                if(NOT "${T_USED_BY}" STREQUAL "")
                    string(APPEND T_TEXT " (used by ${T_USED_BY})")
                endif()

                foreach(SUFFIX IN LISTS IT_TARGET_SUFFIXES)
                    set(IT_TARGET_${TARGET_IDX}_${SUFFIX} "${T_${SUFFIX}}" PARENT_SCOPE)
                endforeach()

            endforeach()

        endif()

    endif()

    set(${COUNT_VAR} ${TARGETS_CNT} PARENT_SCOPE)

endfunction(IntegrationTesting_ReadTargets)

#------------------------------------------------------------------------------#
# Finds a target of IntegrationTesting_ReadTargets by its ID or by the name of
# its board (a board with one target only).
#
# INDEX_VAR [out]: Index of the target (-1 if not found - reported)
# COUNT     [in]:  Count of the targets (IntegrationTesting_ReadTargets)
# ID        [in]:  ID of the target or name of the board
#------------------------------------------------------------------------------#
function(IntegrationTesting_FindTarget INDEX_VAR COUNT ID)

    set(INDEX -1)
    set(BOARD_INDEXES "")
    set(IDS_TEXT "")

    if(COUNT GREATER 0)
        math(EXPR TARGETS_LAST "${COUNT} - 1")
        foreach(TARGET_IDX RANGE ${TARGETS_LAST})
            string(APPEND IDS_TEXT "\n  ${IT_TARGET_${TARGET_IDX}_ID} (${IT_TARGET_${TARGET_IDX}_TEXT})")
            if("${IT_TARGET_${TARGET_IDX}_ID}" STREQUAL "${ID}")
                set(INDEX ${TARGET_IDX})
            elseif("${IT_TARGET_${TARGET_IDX}_BOARD}" STREQUAL "${ID}")
                list(APPEND BOARD_INDEXES ${TARGET_IDX})
            endif()
        endforeach()
    endif()

    list(LENGTH BOARD_INDEXES BOARD_INDEXES_CNT)

    if(INDEX EQUAL -1 AND
       BOARD_INDEXES_CNT EQUAL 1)
        set(INDEX ${BOARD_INDEXES})
    elseif(INDEX EQUAL -1 AND
           BOARD_INDEXES_CNT GREATER 1)
        message(WARNING "Board ${ID} has ${BOARD_INDEXES_CNT} connected boards - select one of them by its ID:${IDS_TEXT}")
    elseif(INDEX EQUAL -1)
        message(WARNING "Board '${ID}' is not connected (detection of connected boards):${IDS_TEXT}")
    endif()

    set(${INDEX_VAR} ${INDEX} PARENT_SCOPE)

endfunction(IntegrationTesting_FindTarget)


